# Copy to .env (never committed). Read by the Compose stack and by meethub through the environment.
# Settings: MEETHUB_<SECTION>_<KEY> overrides config.toml. Secrets live only here (or in *_FILE files).

# MEETHUB_APP_ENV=development
# MEETHUB_HTTP_PUBLIC_URL=http://localhost:8080

# Database password (mariadb/postgres only)
MEETHUB_DATABASE_PASSWORD=change-me
# Redis password, when Redis requires one
# MEETHUB_REDIS_PASSWORD=
# First-run setup token; when unset, one is generated, logged once and written to <data_dir>/setup-token
# MEETHUB_SETUP_TOKEN=
