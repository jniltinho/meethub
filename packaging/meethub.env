# Secrets of the MeetHub service (systemd EnvironmentFile; owner root, group meethub, mode 0640).
# One NAME=value per line, without "export". Put a value in 'single quotes' when it has anything but letters,
# digits and - _ . / : @ (systemd and the shell both read it literally then).
# Never put a secret in config.toml: it is refused there.
# Every other setting can be set here too, as MEETHUB_<SECTION>_<KEY>; this file wins over config.toml.
# After a change: systemctl restart meethub

# MariaDB or PostgreSQL (not needed for SQLite)
#MEETHUB_DATABASE_PASSWORD=

# a Redis that asks for a password
#MEETHUB_REDIS_PASSWORD=

# an S3-compatible bucket for the attachments (files.driver = "s3")
#MEETHUB_FILES_S3_ACCESS_KEY=
#MEETHUB_FILES_S3_SECRET_KEY=

# meetings: the key and secret of the LiveKit server
#MEETHUB_LIVEKIT_API_KEY=
#MEETHUB_LIVEKIT_API_SECRET=

# notification e-mails
#MEETHUB_SMTP_PASSWORD=
