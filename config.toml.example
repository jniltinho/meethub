# MeetHub configuration. Copy to config.toml (never committed) or use MEETHUB_* environment variables,
# which override this file: MEETHUB_<SECTION>_<KEY>, e.g. MEETHUB_HTTP_ADDR=:9090.
# Secrets are NOT accepted here — set them in the environment (.env) or in a file named by <NAME>_FILE:
#   MEETHUB_DATABASE_PASSWORD, MEETHUB_REDIS_PASSWORD, MEETHUB_SETUP_TOKEN,
#   MEETHUB_LIVEKIT_API_KEY, MEETHUB_LIVEKIT_API_SECRET (make init generates both into .env),
#   MEETHUB_SECRET_KEY (32 random bytes in base64, e.g. `openssl rand -base64 32`; it encrypts the stored secrets of
#   authenticator apps: without it two-factor authentication is unavailable; keep a copy with the backups),
#   MEETHUB_OIDC_CLIENT_SECRET (single sign-on)

[app]
env = "development"          # development | production (production requires an https:// public_url)
data_dir = "./data"          # SQLite database and the first-run setup token

[http]
addr = ":8080"
public_url = "http://localhost:8080"   # canonical origin; cookies are Secure when it is https://
trusted_proxies = []                   # CIDRs/IPs whose X-Forwarded-For/-Proto are honored, e.g. ["10.0.0.0/8"]
body_limit_bytes = 1048576
shutdown_timeout = "15s"
cert_file = ""                         # with key_file: the server speaks HTTPS itself (a PEM chain from any CA, or self-signed)
key_file = ""
self_signed = false                    # true, without cert_file: HTTPS with a certificate generated in <data_dir>/tls

[database]
driver = "sqlite"            # sqlite (default, pure Go) | mariadb | postgres
path = ""                    # SQLite file; empty = <data_dir>/meethub.db
host = "localhost"           # mariadb/postgres
port = 0                     # 0 = driver default (3306 / 5432)
name = "meethub"
user = "meethub"
params = ""                  # extra driver parameters, e.g. "sslmode=require"
connect_timeout = "30s"
max_open_conns = 20

[redis]                      # required: background jobs (Asynq) and shared rate limits
addr = "localhost:6379"
db = 0
username = ""
connect_timeout = "30s"

[session]
idle_timeout = "168h"        # 7 days without activity
absolute_lifetime = "720h"   # 30 days at most

[log]
level = "info"               # debug | info | warn | error
format = "json"              # json | text

[files]                      # attachments
driver = "local"             # local (a directory) | s3 (an S3-compatible bucket, for several replicas)
max_size_bytes = 52428800    # per file: 50 MiB
max_per_post = 10            # files a message may carry

[files.local]
dir = ""                     # empty = <data_dir>/files; with several replicas it must be a shared volume

[files.s3]                   # credentials only from MEETHUB_FILES_S3_ACCESS_KEY and MEETHUB_FILES_S3_SECRET_KEY
endpoint = ""                # host[:port], e.g. "rustfs:9000" or "s3.amazonaws.com"
bucket = ""
region = "us-east-1"
use_ssl = true

[livekit]                    # meetings; leave url empty to disable them (the key and secret come from the environment)
url = ""                     # WebSocket URL the browsers use, e.g. "wss://meethub.example.com/livekit" (wss:// in production)
api_url = ""                 # HTTP URL the server uses; empty = url with ws→http, e.g. "http://livekit:7880"

[smtp]                       # notification e-mails; leave host empty to send none (the password only from MEETHUB_SMTP_PASSWORD)
host = ""                    # e.g. "smtp.example.com"
port = 0                     # 0 = 587 (starttls), 465 (tls) or 25 (none)
username = ""
from = ""                    # the sender, e.g. "MeetHub <meethub@example.com>"
tls = "starttls"             # starttls | tls | none (none with a password: loopback or private hosts only)

[notifications]
email_excerpt = true         # e-mails carry the start of each message; false = only who wrote and where

[auth]
password_login = true        # false: only the single sign-on button (needs [oidc]); MEETHUB_AUTH_PASSWORD_LOGIN=true undoes it

[oidc]                       # single sign-on with one OpenID Connect provider; leave issuer empty for none
issuer = ""                  # https:// only, e.g. "https://accounts.google.com" or "https://id.example.com/realms/acme"
client_id = ""               # the secret only from MEETHUB_OIDC_CLIENT_SECRET; redirect URI: <public_url>/api/v1/auth/oidc/callback
name = "single sign-on"      # the button says "Sign in with <name>"
scopes = ["openid", "email", "profile"]
auto_create = false          # create an account for an unknown, verified e-mail
allowed_domains = []         # e-mail domains auto_create accepts, e.g. ["example.com"]; empty = any
default_role = "member"      # member | guest, for accounts created by single sign-on
