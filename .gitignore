# ── private source material (never commit) ───────────────────────────────────
base/

# ── secrets and local data ───────────────────────────────────────────────────
.env
.env.*
!.env.example
config.toml
*.pem
*.key
*.db
*.db-shm
*.db-wal
/data/

# ── build (everything is built in Docker into dist/) ─────────────────────────
/dist/
/bin/
*.test
*.out
coverage.*

# built SPA (frontend → web/dist): only the .gitkeep is committed, for go:embed
web/dist/*
!web/dist/.gitkeep

# ── frontend ─────────────────────────────────────────────────────────────────
node_modules/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/

# ── demo ─────────────────────────────────────────────────────────────────────
# portraits for the demo users are local only (make demo falls back to a placeholder)
scripts/demo/avatars/

# ── editors / agents ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.log
.agents/skills/
.agents/settings.local.json
.claude/*
.codex/
.review/
